# Copy to .env.local (gitignored) and fill in.

# Photorealistic 3D tiles in the focus view, via Cesium ion's free Community plan.
# ion.cesium.com → Access Tokens (assets:read); add "Google Photorealistic 3D Tiles" to My Assets.
VITE_CESIUM_ION_TOKEN=

# Alternative: a Google Maps Platform key with the Map Tiles API (billed beyond the free tier).
VITE_GOOGLE_MAPS_KEY=
